# ZenjiGO backend environment
# Replace every CHANGE_ME value with your own credentials before production use.

NODE_ENV=development
PORT=5000
APP_NAME=ZenjiGO
API_PREFIX=/api/v1

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zenjigo
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=30
# Required by docker compose only. A local MySQL with no password can leave this empty.
DB_ROOT_PASSWORD=

# Authentication (use two different random secrets, at least 32 characters each)
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173,http://localhost:5500,http://localhost:5501,https://zenjigo.online,https://www.zenjigo.online,https://admin.zenjigo.online

# Cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_FOLDER=zenjigo

# Firebase Admin / push notifications
# Use either a service-account JSON file path or the three FIREBASE_* values below.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_CLIENT_EMAIL=CHANGE_ME
FIREBASE_PRIVATE_KEY="CHANGE_ME"

# OTP and API security
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=8
OTP_ALLOW_CONSOLE=false
# Non-production only. When set, OTP codes use this value instead of a random code.
OTP_DEV_FIXED_CODE=
AUTH_RATE_LIMIT_MAX=30
MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000

# Briq Karibu SMS (https://docs.briq.tz). Sender must already be approved on the account.
BRIQ_API_KEY=
BRIQ_APP_ID=
BRIQ_BASE_URL=https://karibu.briq.tz
BRIQ_SENDER_ID=SOSHO

# SMS behaviour (all optional)
SMS_NOTIFICATIONS_ENABLED=true          # ride/account/finance SMS; OTP codes are always sent
ADMIN_OTP_SMS=true                       # admins may choose the sign-in code by SMS (needs a real admin phone)
REQUIRE_DRIVER_PHONE_VERIFICATION=true   # drivers must verify their phone by SMS when registering
SMS_BROADCAST_MAX=2000                   # max recipients per admin broadcast
# Auto-fill the SMS code in browsers (WebOTP): your site domain, e.g. zenjigo.online
OTP_WEBOTP_DOMAIN=
# Android SMS Retriever app hash (11 chars), if you use it in the Flutter apps
OTP_ANDROID_APP_HASH=

# Email
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="ZenjiGO <no-reply@example.com>"

# Seed admin (change immediately; use a strong unique password)
SEED_ADMIN_EMAIL=admin@zenjigo.example
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADMIN_PHONE=+255700000001

# PayGrid / Briq MeetPay
PAYMENT_PROVIDER=paygrid
PAYGRID_API_BASE_URL=https://meet.briq.tz
PAYGRID_API_KEY=CHANGE_ME_PAYGRID_API_KEY
PAYGRID_SECRET_KEY=
PAYGRID_MERCHANT_ID=
PAYGRID_PUBLIC_KEY=
# Webhook signing key from PayGrid dashboard (not the API key)
PAYGRID_WEBHOOK_SECRET=CHANGE_ME_PAYGRID_WEBHOOK_SECRET
# Register this exact public URL in the PayGrid dashboard
PAYGRID_CALLBACK_URL=https://api.example.com/api/v1/payments/webhook
# Keep false. Unsigned webhooks are never accepted in production.
ALLOW_UNSIGNED_WEBHOOKS=false

# Driver settlements and cancellation rules
DRIVER_SETTLEMENT_THRESHOLD_TZS=60000
DRIVER_COMMISSION_PERCENT=20
DRIVER_AUTOPAY_PROVIDER=paygrid
CANCEL_NEAR_PICKUP_KM=1
CANCEL_NEAR_PICKUP_PERCENT=20
SETTLEMENT_PROCESSING_TIMEOUT_MIN=15
LIVE_TRACK_PUSH_INTERVAL_MS=120000

# Ride pricing / defaults (TZS)
CURRENCY=TZS
DEFAULT_COUNTRY_CODE=+255
DEFAULT_RIDE_TIMEOUT_SECONDS=45
DRIVER_LOCATION_STALE_SECONDS=60
BASE_FARE_TZS=2500
PER_KM_FARE_TZS=900
PER_MINUTE_FARE_TZS=150
BOOKING_FEE_TZS=500

# Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Dispatch / ride lifecycle
DISPATCH_RADIUS_KM=8
RIDE_SEARCH_WINDOW_SECONDS=180
SOCKET_LOCATION_MIN_INTERVAL_MS=1000
LOCATION_HISTORY_INTERVAL_MS=10000
RIDE_DRIVER_STALE_MINUTES=10
RIDE_ACCEPTED_MAX_MINUTES=45
RIDE_NOSHOW_MINUTES=15
RIDE_TRIP_STALE_MINUTES=30
RIDE_TRIP_MAX_HOURS=6
RIDE_CASH_AUTOCONFIRM_MINUTES=30
RIDE_PAYMENT_OVERDUE_MINUTES=60
RIDE_PAYMENT_TTL_MINUTES=4
RIDE_MAX_REDISPATCH=2
RIDE_MAX_DISTANCE_KM=150
RIDE_MIN_DISTANCE_KM=0.05
